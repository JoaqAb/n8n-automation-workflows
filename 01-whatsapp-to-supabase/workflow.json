{
  "name": "NortePeak — Intake y calificación de leads",
  "meta": {
    "note": "Export sanitizado. Sin IDs de cuenta, credenciales ni números de teléfono reales. Caso self-initiated de portfolio, negocio ficticio (NortePeak, instalador solar). Ver README.md de esta carpeta y docs/portfolio/N8N_CASES.md en lokebox-landing."
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "id": "n01",
      "name": "Webhook - Form",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "nortepeak/lead-form",
        "responseMode": "responseNode"
      }
    },
    {
      "id": "n02",
      "name": "Webhook - WhatsApp",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        320
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "nortepeak/whatsapp",
        "responseMode": "responseNode"
      }
    },
    {
      "id": "n03",
      "name": "Normalize - Form",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "source",
              "type": "string",
              "value": "web_form"
            },
            {
              "id": "a2",
              "name": "nombre",
              "type": "string",
              "value": "={{ $json.body.nombre }}"
            },
            {
              "id": "a3",
              "name": "telefono",
              "type": "string",
              "value": "={{ $json.body.telefono }}"
            },
            {
              "id": "a4",
              "name": "email",
              "type": "string",
              "value": "={{ $json.body.email }}"
            },
            {
              "id": "a5",
              "name": "direccion",
              "type": "string",
              "value": "={{ $json.body.direccion }}"
            },
            {
              "id": "a6",
              "name": "ciudad",
              "type": "string",
              "value": "={{ $json.body.ciudad }}"
            },
            {
              "id": "a7",
              "name": "tipo_cliente",
              "type": "string",
              "value": "={{ $json.body.tipo_cliente }}"
            },
            {
              "id": "a8",
              "name": "consumo_declarado_kwh",
              "type": "number",
              "value": "={{ $json.body.consumo_kwh || null }}"
            },
            {
              "id": "a9",
              "name": "urgencia",
              "type": "string",
              "value": "={{ $json.body.urgencia }}"
            },
            {
              "id": "a10",
              "name": "raw_payload",
              "type": "object",
              "value": "={{ $json.body }}"
            }
          ]
        }
      }
    },
    {
      "id": "n04",
      "name": "Normalize - WhatsApp",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        320
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "b1",
              "name": "source",
              "type": "string",
              "value": "whatsapp"
            },
            {
              "id": "b2",
              "name": "nombre",
              "type": "string",
              "value": "={{ $json.body.contacts[0].profile.name }}"
            },
            {
              "id": "b3",
              "name": "telefono",
              "type": "string",
              "value": "={{ $json.body.contacts[0].wa_id }}"
            },
            {
              "id": "b4",
              "name": "email",
              "type": "string",
              "value": "=null"
            },
            {
              "id": "b5",
              "name": "direccion",
              "type": "string",
              "value": "={{ $json.body.messages[0].text?.body?.match(/direcci[oó]n:\\s*(.*)/i)?.[1] || null }}"
            },
            {
              "id": "b6",
              "name": "ciudad",
              "type": "string",
              "value": "={{ $json.body.messages[0].text?.body?.match(/ciudad:\\s*(.*)/i)?.[1] || null }}"
            },
            {
              "id": "b7",
              "name": "tipo_cliente",
              "type": "string",
              "value": "={{ $json.body.messages[0].text?.body?.match(/pyme/i) ? 'pyme' : 'residencial' }}"
            },
            {
              "id": "b8",
              "name": "consumo_declarado_kwh",
              "type": "number",
              "value": "={{ Number($json.body.messages[0].text?.body?.match(/(\\d+)\\s*kwh/i)?.[1]) || null }}"
            },
            {
              "id": "b9",
              "name": "urgencia",
              "type": "string",
              "value": "={{ $json.body.messages[0].text?.body?.match(/urgente/i) ? 'inmediata' : 'explorando' }}"
            },
            {
              "id": "b10",
              "name": "raw_payload",
              "type": "object",
              "value": "={{ $json.body }}"
            }
          ]
        }
      }
    },
    {
      "id": "n05",
      "name": "Merge Channels",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        440,
        160
      ],
      "parameters": {
        "mode": "append"
      }
    },
    {
      "id": "n06",
      "name": "Insert Lead (Raw)",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        660,
        160
      ],
      "parameters": {
        "operation": "create",
        "tableId": "leads",
        "dataToSend": "autoMapInputData"
      },
      "notes": "Se inserta apenas llega, con estado='nuevo' por default. Nunca se pierde el dato crudo aunque algo falle más adelante en el pipeline — mismo criterio que bot/claude.js en lokebox-app."
    },
    {
      "id": "n07",
      "name": "Check Duplicate",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        880,
        160
      ],
      "parameters": {
        "operation": "getAll",
        "tableId": "leads",
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "telefono",
              "condition": "eq",
              "keyValue": "={{ $json.telefono }}"
            },
            {
              "keyName": "created_at",
              "condition": "gte",
              "keyValue": "={{ $now.minus({ hours: 48 }).toISO() }}"
            },
            {
              "keyName": "id",
              "condition": "neq",
              "keyValue": "={{ $json.id }}"
            }
          ]
        }
      },
      "notes": "Edge case: mismo teléfono en 48hs se trata como duplicado, no como lead nuevo.",
      "alwaysOutputData": true
    },
    {
      "id": "n08",
      "name": "If Duplicate",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1100,
        160
      ],
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "exists",
                "singleValue": true
              }
            }
          ]
        }
      }
    },
    {
      "id": "n09",
      "name": "Mark Duplicado",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        1320,
        60
      ],
      "parameters": {
        "operation": "update",
        "tableId": "leads",
        "filterType": "manual",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "estado",
              "fieldValue": "duplicado"
            }
          ]
        },
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $('Insert Lead (Raw)').item.json.id }}"
            }
          ]
        }
      }
    },
    {
      "id": "n10",
      "name": "Respond - Duplicado",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1540,
        60
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"status\": \"ya_tenemos_tu_consulta\", \"mensaje\": \"Ya tenemos tu consulta reciente, un asesor te va a contactar.\" } }}"
      }
    },
    {
      "id": "n11",
      "name": "Check Zone",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        1320,
        260
      ],
      "parameters": {
        "operation": "getAll",
        "tableId": "zonas_cobertura",
        "filterType": "manual",
        "filters": {
          "conditions": [
            {
              "keyName": "ciudad",
              "condition": "eq",
              "keyValue": "={{ $('Insert Lead (Raw)').item.json.ciudad }}"
            }
          ]
        }
      },
      "alwaysOutputData": true
    },
    {
      "id": "n12",
      "name": "If Fuera de Zona",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1540,
        260
      ],
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ !$json.ciudad || $json.cobertura === false }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        }
      },
      "notes": "Edge case: ciudad no está en el catálogo de cobertura, o está marcada cobertura=false (ej. Santiago del Estero en el seed)."
    },
    {
      "id": "n13",
      "name": "Mark Fuera de Zona",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        1760,
        160
      ],
      "parameters": {
        "operation": "update",
        "tableId": "leads",
        "filterType": "manual",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "estado",
              "fieldValue": "fuera_de_zona"
            },
            {
              "fieldId": "zona_cobertura",
              "fieldValue": "false"
            }
          ]
        },
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $('Insert Lead (Raw)').item.json.id }}"
            }
          ]
        }
      }
    },
    {
      "id": "n14",
      "name": "Respond - Fuera de Zona",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1980,
        160
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"status\": \"fuera_de_zona\", \"mensaje\": \"Por ahora no cubrimos tu zona, pero guardamos tu consulta para cuando ampliemos cobertura.\" } }}"
      },
      "notes": "Nunca pasa a un vendedor. El lead queda registrado (para medir demanda fuera de zona) pero no genera carga de trabajo humana."
    },
    {
      "id": "n15",
      "name": "If Dato Faltante",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1760,
        360
      ],
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $('Insert Lead (Raw)').item.json.consumo_declarado_kwh }}",
              "rightValue": "",
              "operator": {
                "type": "number",
                "operation": "empty",
                "singleValue": true
              }
            }
          ]
        }
      },
      "notes": "Edge case: sin consumo declarado no se califica con un null silencioso, se pide el dato."
    },
    {
      "id": "n16",
      "name": "Mark Dato Faltante",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        1980,
        460
      ],
      "parameters": {
        "operation": "update",
        "tableId": "leads",
        "filterType": "manual",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "estado",
              "fieldValue": "dato_faltante"
            }
          ]
        },
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $('Insert Lead (Raw)').item.json.id }}"
            }
          ]
        }
      }
    },
    {
      "id": "n17",
      "name": "Respond - Dato Faltante",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        2200,
        460
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"status\": \"falta_dato\", \"mensaje\": \"Para cotizarte necesitamos tu consumo mensual aproximado en kWh, ¿nos lo pasás?\" } }}"
      }
    },
    {
      "id": "n18",
      "name": "AI Qualification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1980,
        260
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "jsonBody": "={{ { \"model\": \"claude-sonnet-5\", \"thinking\": { \"type\": \"disabled\" }, \"max_tokens\": 300, \"messages\": [ { \"role\": \"user\", \"content\": \"Clasificá este lead de instalación solar. Ciudad: \" + $('Insert Lead (Raw)').item.json.ciudad + \". Tipo: \" + $('Insert Lead (Raw)').item.json.tipo_cliente + \". Consumo declarado: \" + $('Insert Lead (Raw)').item.json.consumo_declarado_kwh + \" kWh. Urgencia: \" + $('Insert Lead (Raw)').item.json.urgencia + \". Devolvé JSON con: score_ia (0-100), confianza_ia (0-1), presupuesto_estimado_rango. Respondé solo con ese JSON plano, sin texto alrededor y sin markdown.\" } ] } }}",
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        }
      },
      "notes": "Misma técnica de extracción/clasificación con Claude que bot/claude.js en lokebox-app (producción real con Kieba), aplicada a un dominio distinto."
    },
    {
      "id": "n19",
      "name": "Parse AI Response",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        2200,
        260
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "c1",
              "name": "score_ia",
              "type": "number",
              "value": "={{ JSON.parse($json.content.find(b => b.type === 'text').text.match(/\\{[\\s\\S]*\\}/)[0]).score_ia }}"
            },
            {
              "id": "c2",
              "name": "confianza_ia",
              "type": "number",
              "value": "={{ JSON.parse($json.content.find(b => b.type === 'text').text.match(/\\{[\\s\\S]*\\}/)[0]).confianza_ia }}"
            },
            {
              "id": "c3",
              "name": "presupuesto_estimado_rango",
              "type": "string",
              "value": "={{ JSON.parse($json.content.find(b => b.type === 'text').text.match(/\\{[\\s\\S]*\\}/)[0]).presupuesto_estimado_rango }}"
            }
          ]
        }
      }
    },
    {
      "id": "n20",
      "name": "If Confianza Baja",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        2420,
        260
      ],
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.confianza_ia }}",
              "rightValue": 0.7,
              "operator": {
                "type": "number",
                "operation": "lt"
              }
            }
          ]
        }
      },
      "notes": "Edge case: confianza del modelo baja no se autocalifica, pasa a revisión manual. Mismo patrón que la 'pregunta abierta' persistente del bot Lokey."
    },
    {
      "id": "n21",
      "name": "Mark Revision Manual",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        2640,
        160
      ],
      "parameters": {
        "operation": "update",
        "tableId": "leads",
        "filterType": "manual",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "estado",
              "fieldValue": "revision_manual"
            },
            {
              "fieldId": "motivo_revision_manual",
              "fieldValue": "={{ \"confianza_ia=\" + $('Parse AI Response').item.json.confianza_ia + \" por debajo del umbral 0.7\" }}"
            }
          ]
        },
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $('Insert Lead (Raw)').item.json.id }}"
            }
          ]
        }
      }
    },
    {
      "id": "n22",
      "name": "Alert - Revision Manual",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [
        2860,
        160
      ],
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": "#nortepeak-revision-manual",
        "text": "=Lead de {{ $json.nombre }} ({{ $json.ciudad }}) necesita revisión manual: {{ $json.motivo_revision_manual }}"
      }
    },
    {
      "id": "n23",
      "name": "Respond - Recibido (Revision)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        3080,
        160
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"status\": \"recibido\", \"mensaje\": \"Recibimos tu consulta, un asesor la está revisando y te contacta a la brevedad.\" } }}"
      }
    },
    {
      "id": "n24",
      "name": "Geocode Address",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2640,
        360
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://nominatim.openstreetmap.org/search?format=json&q={{ encodeURIComponent($('Insert Lead (Raw)').item.json.direccion + ', ' + $('Insert Lead (Raw)').item.json.ciudad) }}",
        "options": {}
      },
      "notes": "Enrichment: geocoding de la dirección declarada para estimar zona/orientación aproximada. API pública, sin credencial."
    },
    {
      "id": "n25",
      "name": "Update Lead - Calificado",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        2860,
        360
      ],
      "parameters": {
        "operation": "update",
        "tableId": "leads",
        "filterType": "manual",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "estado",
              "fieldValue": "calificado"
            },
            {
              "fieldId": "score_ia",
              "fieldValue": "={{ $('Parse AI Response').item.json.score_ia }}"
            },
            {
              "fieldId": "confianza_ia",
              "fieldValue": "={{ $('Parse AI Response').item.json.confianza_ia }}"
            },
            {
              "fieldId": "presupuesto_estimado_rango",
              "fieldValue": "={{ $('Parse AI Response').item.json.presupuesto_estimado_rango }}"
            },
            {
              "fieldId": "zona_cobertura",
              "fieldValue": "true"
            },
            {
              "fieldId": "lat",
              "fieldValue": "={{ $json.lat || null }}"
            },
            {
              "fieldId": "lng",
              "fieldValue": "={{ $json.lon || null }}"
            }
          ]
        },
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $('Insert Lead (Raw)').item.json.id }}"
            }
          ]
        }
      }
    },
    {
      "id": "n26",
      "name": "Assign Salesperson",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3080,
        360
      ],
      "parameters": {
        "jsCode": "// Asigna por vendedor_default de la zona si existe, si no, round-robin por carga_actual más baja.\nconst zona = $('Check Zone').first().json;\nconst vendedores = $('Vendedores Activos').all();\nlet asignado = zona?.vendedor_default || null;\nif (!asignado) {\n  const ordenados = vendedores.map(v => v.json).sort((a, b) => a.carga_actual - b.carga_actual);\n  asignado = ordenados[0]?.nombre || null;\n}\nreturn [{ json: { ...$input.first().json, vendedor_asignado: asignado } }];"
      },
      "notes": "Routing: primero intenta el vendedor_default de la zona (seed: Marina Ponce en SMT/Yerba Buena, Ezequiel Soler en Tafí Viejo). Si no hay default, asigna al de menor carga_actual."
    },
    {
      "id": "n27",
      "name": "Vendedores Activos",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        2640,
        -40
      ],
      "parameters": {
        "operation": "getAll",
        "tableId": "vendedores",
        "filterType": "manual",
        "filters": {
          "conditions": [
            {
              "keyName": "activo",
              "condition": "eq",
              "keyValue": "true"
            }
          ]
        }
      },
      "notes": "Corre en paralelo a Update Lead - Calificado, alimenta a Assign Salesperson."
    },
    {
      "id": "n28",
      "name": "Update Lead - Asignado",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        3300,
        360
      ],
      "parameters": {
        "operation": "update",
        "tableId": "leads",
        "filterType": "manual",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "estado",
              "fieldValue": "asignado"
            },
            {
              "fieldId": "vendedor_asignado",
              "fieldValue": "={{ $json.vendedor_asignado }}"
            },
            {
              "fieldId": "fecha_asignacion",
              "fieldValue": "={{ $now.toISO() }}"
            }
          ]
        },
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $('Insert Lead (Raw)').item.json.id }}"
            }
          ]
